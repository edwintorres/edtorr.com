<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="format-detection" content="telephone=no">
  <title>{{ title or metadata.title }}</title>
  <meta name="description" content="{{ description or metadata.description }}">

  {% set socialImage = headerImage if headerImage else '/assets/images/og_image.jpg' %}
  {% set socialTitle = title or metadata.title or 'Edwin Torres' %}
  {% set socialDescription = description or metadata.description or 'I build technology to create better solutions for people.' %}
  {% set socialUrl = page.url | absoluteUrl(metadata.url) %}

  <!-- Open Graph Meta Tags (for Facebook, LinkedIn, etc.) -->
  <meta property="og:title" content="{{ socialTitle }}">
  <meta property="og:description" content="{{ socialDescription }}">
  <meta property="og:image" content="{{ socialImage | absoluteUrl(metadata.url) }}">
  <meta property="og:url" content="{{ socialUrl }}">
  <meta property="og:type" content="{{ 'article' if tags and 'posts' in tags else 'website' }}">

  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ socialTitle }}">
  <meta name="twitter:description" content="{{ socialDescription }}">
  <meta name="twitter:image" content="{{ socialImage | absoluteUrl(metadata.url) }}">
  <meta name="twitter:url" content="{{ socialUrl }}">

  <!-- Canonical and hreflang -->
  <link rel="canonical" href="{{ socialUrl }}">
  <link rel="alternate" hreflang="{{ locale }}" href="{{ socialUrl }}">
  {% if translation %}
  <link rel="alternate" hreflang="{{ 'es' if locale == 'en' else 'en' }}" href="{{ translation | absoluteUrl(metadata.url) }}">
  {% endif %}
  <link rel="alternate" hreflang="x-default" href="{{ socialUrl }}">

  {% if tags and 'posts' in tags %}
  <!-- Article structured data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ socialTitle | dump | safe }},
      "description": {{ socialDescription | dump | safe }},
      "image": {{ (socialImage | absoluteUrl(metadata.url)) | dump | safe }},
      "author": {
        "@type": "Person",
        "name": {{ metadata.author.name | dump | safe }},
        "url": {{ metadata.author.url | dump | safe }}
      },
      "datePublished": "{{ date | htmlDateString }}",
      "inLanguage": "{{ locale }}",
      "url": {{ socialUrl | dump | safe }},
      "mainEntityOfPage": {{ socialUrl | dump | safe }}
    }
  </script>
  {% endif %}

  <!-- Preload Key Resources -->
  <link rel="preload" href="{{ '/assets/vendor/css/style.css' | hash }}" as="style">

  <!-- CSS with Cache Busting -->
  <link rel="stylesheet" href="{{ '/assets/vendor/css/prism-base16-monokai.dark.css' | hash }}">
  <link href="{{ '/assets/vendor/css/bootstrap.min.css' | hash }}" rel="stylesheet" />
  <link href="{{ '/assets/vendor/css/materialdesignicons.min.css' | hash }}" rel="stylesheet" />
  <link rel="stylesheet" href="https://unicons.iconscout.com/release/v3.0.6/css/line.css">
  <link href="{{ '/assets/vendor/css/style.css' | hash }}" rel="stylesheet" id="theme-opt" />

  <style>
    .sidebar .post-recent .post-recent-thumb {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 0.375rem;
    }
    .sidebar .post-recent .post-recent-thumb a,
    .sidebar .post-recent .post-recent-thumb picture {
      display: block;
      width: 100%;
      height: 100%;
    }
    .sidebar .post-recent .post-recent-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  </style>

  <!-- ✅ FAVICONS FOR ALL DEVICES -->
  <!-- Standard Favicon -->
  <link rel="icon" type="image/png" sizes="16x16"   href="{{ '/assets/images/favicon/favicon-16x16.png' | hash }}">
  <link rel="icon" type="image/png" sizes="32x32"   href="{{ '/assets/images/favicon/favicon-32x32.png' | hash }}">
  <link rel="icon" type="image/png" sizes="96x96"   href="{{ '/assets/images/favicon/favicon-96x96.png' | hash }}">
  <link rel="icon" type="image/png" sizes="192x192" href="{{ '/assets/images/favicon/android-icon-144x144.png' | hash }}">
  <link rel="icon" type="image/png" sizes="192x192" href="{{ '/assets/images/favicon/android-icon-192x192.png' | hash }}">

  <!-- Apple Touch Icons (iOS, macOS) -->
  <link rel="apple-touch-icon" sizes="57x57" href="{{ '/assets/images/favicon/apple-icon-57x57.png' | hash }}">
  <link rel="apple-touch-icon" sizes="60x60" href="{{ '/assets/images/favicon/apple-icon-60x60.png' | hash }}">
  <link rel="apple-touch-icon" sizes="72x72" href="{{ '/assets/images/favicon/apple-icon-72x72.png' | hash }}">
  <link rel="apple-touch-icon" sizes="76x76" href="{{ '/assets/images/favicon/apple-icon-76x76.png' | hash }}">
  <link rel="apple-touch-icon" sizes="114x114" href="{{ '/assets/images/favicon/apple-icon-114x114.png' | hash }}">
  <link rel="apple-touch-icon" sizes="120x120" href="{{ '/assets/images/favicon/apple-icon-120x120.png' | hash }}">
  <link rel="apple-touch-icon" sizes="144x144" href="{{ '/assets/images/favicon/apple-icon-144x144.png' | hash }}">
  <link rel="apple-touch-icon" sizes="152x152" href="{{ '/assets/images/favicon/apple-icon-152x152.png' | hash }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/images/favicon/apple-icon-180x180.png' | hash }}">

  <!-- Microsoft (Windows Tiles) -->
  <meta name="msapplication-TileImage" content="{{ '/assets/images/favicon/ms-icon-144x144.png' | hash }}">
  <meta name="msapplication-TileColor" content="#ffffff">

  <!-- Web App Manifest (For PWA and Android) -->
  <link rel="manifest" href="{{ '/assets/images/favicon/manifest.json' | hash }}">

  {% if env.isProduction %}
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-T5HZMBG9DM"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-T5HZMBG9DM');
  </script>
  {% endif %}

</head>
